LinkColor := #ff0000;
ParWidth := 500px;
AdjustColor := TRUE;
UseLinkColor := FALSE;

p {
	background-color: #ffffff;
	width: ParWidth;
	if[AdjustColor] {
	    TestColor := #123456;
	    color: TestColor;
	    if[UseLinkColor]{
	        background-color: LinkColor;
	    } else {
	        background-color: #000000;
	        if[TRUE]{
                background-color: LinkColor;
            } else {
            	background-color: #000000;
            }
	    }
	}
	if[UseLinkColor]{
        background-color: LinkColor;
    } else {
    	background-color: #000000;
    }
    if[FALSE]{

    }
	height: 20px;
}
a {
	color: LinkColor;
}

#menu {
	width: ParWidth + 20px;
}

.menu {
	color: #000000;
    background-color: LinkColor;

}
